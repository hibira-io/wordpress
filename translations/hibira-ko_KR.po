msgid ""
msgstr ""
"Project-Id-Version: Hibira Realtime 0.1.0\n"
"Report-Msgid-Bugs-To: https://github.com/hibira-io/wordpress/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ko_KR\n"
"X-Domain: hibira\n"

msgid "Settings"
msgstr "설정"

msgid "You are not allowed to do this."
msgstr "이 작업을 할 권한이 없습니다."

msgid "Connected. A test event was sent to the channel \"hibira-test\"; you can see it in the debug console of your app in the Hibira portal."
msgstr "연결되었습니다. 테스트 이벤트를 채널 \"hibira-test\"로 보냈습니다. Hibira 포털의 앱 디버그 콘솔에서 확인할 수 있습니다."

msgid "Create a free app at %s (no card needed), then copy its app ID, key and secret here."
msgstr "%s 에서 무료 앱을 만들고(카드 불필요) App ID, Key, Secret을 여기에 붙여 넣으세요."

msgid "Connection"
msgstr "연결"

msgid "App ID"
msgstr "App ID"

msgid "Key"
msgstr "Key"

msgid "Secret"
msgstr "Secret"

msgid "Saved. Leave empty to keep it."
msgstr "저장되어 있습니다. 비워 두면 그대로 유지됩니다."

msgid "Never sent to browsers. To keep it out of the database, define HIBIRA_APP_SECRET in wp-config.php instead."
msgstr "브라우저로 전송되지 않습니다. 데이터베이스에 저장하지 않으려면 wp-config.php에 HIBIRA_APP_SECRET을 정의하세요."

msgid "Host"
msgstr "호스트"

msgid "ws.hibira.io for the default cluster. Change it only for another cluster or a self-hosted server."
msgstr "기본 클러스터는 ws.hibira.io입니다. 다른 클러스터나 자체 호스팅 서버를 쓸 때만 바꾸세요."

msgid "Port"
msgstr "포트"

msgid "TLS (https and wss)"
msgstr "TLS(https 및 wss)"

msgid "Features"
msgstr "기능"

msgid "Live comments"
msgstr "실시간 댓글"

msgid "Approved comments appear for every reader of the post without a reload."
msgstr "승인된 댓글이 새로고침 없이 글을 읽는 모든 사람에게 표시됩니다."

msgid "Post updated notice"
msgstr "글 업데이트 알림"

msgid "Readers of a post see a notice with a reload button when you update it."
msgstr "글을 업데이트하면 읽고 있는 사람에게 새로고침 버튼이 있는 알림이 표시됩니다."

msgid "Readers now"
msgstr "지금 읽는 사람 수"

msgid "Shows how many people are reading a post. Each reader holds a presence channel connection; counts above 100 show as 100+. It shows in a corner of the page, or where you put the [hibira_readers] shortcode or the hibira_readers() template tag."
msgstr "글을 읽고 있는 사람 수를 보여 줍니다. 독자마다 presence 채널 연결을 하나씩 사용하며 100명이 넘으면 100+로 표시합니다. 페이지 모서리나 [hibira_readers] 숏코드, hibira_readers() 템플릿 태그를 넣은 곳에 표시됩니다."

msgid "WooCommerce order status"
msgstr "WooCommerce 주문 상태"

msgid "The order received and view order pages update when the order status changes."
msgstr "주문 상태가 바뀌면 주문 완료 페이지와 주문 보기 페이지가 바로 업데이트됩니다."

msgid "Admin notices"
msgstr "관리자 알림"

msgid "Shows a notice in wp-admin for new orders and for comments awaiting approval."
msgstr "새 주문이나 승인 대기 댓글이 있으면 wp-admin에 알림을 표시합니다."

msgid "Check the connection"
msgstr "연결 확인"

msgid "Send a test event"
msgstr "테스트 이벤트 보내기"

msgid "Hibira is not configured."
msgstr "Hibira가 설정되지 않았습니다."

msgid "This post was updated."
msgstr "이 글이 업데이트되었습니다."

msgid "Reload"
msgstr "새로고침"

msgid "New comment"
msgstr "새 댓글"

msgid "%s reading now"
msgstr "%s명이 읽는 중"

msgid "100+ reading now"
msgstr "100명 이상 읽는 중"

msgid "Order status: %s"
msgstr "주문 상태: %s"

msgid "New order %s"
msgstr "새 주문 %s"

msgid "New comment awaiting approval on \"%s\""
msgstr "\"%s\"에 승인 대기 중인 새 댓글이 있습니다"

msgid "View"
msgstr "보기"

msgid "Dismiss"
msgstr "닫기"

